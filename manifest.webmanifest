{
  "name": "ServeApp — Tennis Serve Counter",
  "short_name": "ServeApp",
  "description": "Tap to count tennis serves, review every session, and see your practice on a calendar.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0e14",
